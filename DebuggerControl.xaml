<UserControl x:Class="AutoCADAddInManager.DebuggerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             FontFamily="Microsoft YaHei UI" FontSize="12"
             Background="#F3F5F7">
    <UserControl.Resources>
        <!-- 面板按钮的统一外观。 -->
        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 加载是主要入口，使用强调色。 -->
        <Style x:Key="LoadButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 运行命令使用独立颜色，便于快速识别。 -->
        <Style x:Key="RunButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 增加树节点的留白和选中反馈。 -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="#27364A"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8EDF3"/>
                    <Setter Property="Foreground" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="8,8,8,0" Background="#FFFFFF"
                BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
            <TreeView x:Name="treeCommands" Padding="5" Background="Transparent"
                      BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ToolTip="DLL 为一级节点；双击 DLL 可复制并加载程序集，展开后可查看并运行其中的命令">
                <TreeView.Resources>
                    <!-- 覆盖系统默认亮蓝色，使用更柔和的节点选中颜色。 -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E8EDF3"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#334155"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F0F3F7"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#475569"/>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <Grid Grid.Row="1" Margin="8,7,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnLoad" Grid.Column="0" Content="加载 DLL"
                    Margin="0,0,3,0" Style="{StaticResource LoadButtonStyle}"
                    ToolTip="添加新的 DLL，或重新加载已添加的 DLL"/>
            <Button x:Name="btnRemove" Grid.Column="1" Content="移除"
                    Margin="3,0" Style="{StaticResource PanelButtonStyle}" IsEnabled="False"
                    ToolTip="移除当前选中的 DLL 或命令"/>
            <Button x:Name="btnRun" Grid.Column="2" Content="运行命令" IsEnabled="False"
                    Margin="3,0,0,0" Style="{StaticResource RunButtonStyle}"
                    ToolTip="运行当前选中的命令，也可以直接双击命令"/>
        </Grid>

        <Grid Grid.Row="2" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnReloadDll" Grid.Column="0" Content="重载 DLL"
                    Margin="0,0,3,0" Style="{StaticResource PanelButtonStyle}" IsEnabled="False"
                    ToolTip="复制当前 DLL 及其依赖到临时目录并加载程序集"/>
            <Button x:Name="btnConfigureDependencies" Grid.Column="1" Grid.ColumnSpan="2" Content="配置依赖项"
                    Margin="3,0,0,0" Style="{StaticResource PanelButtonStyle}" IsEnabled="False"
                    ToolTip="选择运行此 DLL 时需要额外复制到临时目录的文件"/>
        </Grid>
    </Grid>
</UserControl>
