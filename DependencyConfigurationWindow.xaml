<Window x:Class="AutoCADAddInManager.DependencyConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置依赖项"
        Width="620" Height="680" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        Background="#F3F5F7">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="选择运行命令时需要额外复制到临时目录的文件。"
                       FontWeight="SemiBold" Foreground="#27364A"/>
            <TextBlock Text="DLL 及其同名文件、运行时引用的托管依赖会自动处理，无需重复选择。"
                       Margin="0,4,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding PluginFolder}" Margin="0,5,0,0"
                       Foreground="#475569" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding PluginFolder}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="搜索" Margin="0,0,8,0"
                       VerticalAlignment="Center" Foreground="#475569"/>
            <TextBox x:Name="searchTextBox" Grid.Column="1" Height="30"
                     Padding="7,4" VerticalContentAlignment="Center"
                     ToolTip="按文件名或相对路径搜索"
                     TextChanged="SearchTextBox_TextChanged"/>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1"
                BorderThickness="1" CornerRadius="4">
            <TreeView ItemsSource="{Binding RootNodes}" Padding="6" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Visibility" Value="{Binding Visibility}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsThreeState="{Binding IsDirectory}"
                                  VerticalContentAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="#27364A"/>
                        </CheckBox>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="88"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="清空选择" Width="90" Height="32"
                    HorizontalAlignment="Left" Click="ClearSelection_Click"/>
            <Button Grid.Column="1" Content="取消" Height="32" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Grid.Column="2" Content="保存" Height="32"
                    IsDefault="True" Click="Save_Click"
                    Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8"/>
        </Grid>
    </Grid>
</Window>
